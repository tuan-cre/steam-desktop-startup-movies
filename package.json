{
    "scripts": {
        "build": "millennium-ttc --build prod",
        "dev": "millennium-ttc --build dev",
        "postbuild": "node -e \"const fs=require('fs'),path=require('path');const src='.millennium/Dist',dst='frontend';fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(path.join(src,f),path.join(dst,f))}\""
    },
    "devDependencies": {
        "@steambrew/client": "^5.8.4",
        "@steambrew/ttc": "^3.2.6",
        "@types/react": "19.1.1",
        "@types/react-dom": "19.1.1"
    },
    "type": "module",
    "name": "startup-movies",
    "version": "1.3.0",
    "license": "MIT",
    "main": "./frontend/index.tsx",
    "description": "Startup Movies plugin for desktop Steam"
}
